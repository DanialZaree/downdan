{
  "manifest_version": 3,
  "name": "danDown Download Manager Integration",
  "version": "0.5.0",
  "description": "IDM-style download confirmation popup, automatic download interception, and floating video/audio stream downloader for danDown.",
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "danDown Integration",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
